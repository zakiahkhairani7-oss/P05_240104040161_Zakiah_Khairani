<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/formRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/p05_page"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            style="@style/Widget.WargaHubP05.Title"
            android:text="@string/judul_form" />
        <TextView
            android:id="@+id/tvPetunjuk"
            style="@style/Widget.WargaHubP05.Text" />
        <TextView
            style="@style/Widget.WargaHubP05.Text"
            android:labelFor="@id/etJudul"
            android:text="@string/label_judul" />
        <EditText
            android:id="@+id/etJudul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/hint_judul"
            android:inputType="textCapSentences"
            android:maxLines="1" />
        <TextView
            style="@style/Widget.WargaHubP05.Text"
            android:labelFor="@id/spinnerKategori"
            android:text="@string/label_kategori" />
        <Spinner
            android:id="@+id/spinnerKategori"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:entries="@array/kategori_laporan" />
        <TextView
            style="@style/Widget.WargaHubP05.Text"
            android:labelFor="@id/etDeskripsi"
            android:text="@string/label_deskripsi" />
        <EditText
            android:id="@+id/etDeskripsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:minLines="3"
            android:hint="@string/hint_deskripsi"
            android:inputType="textCapSentences|textMultiLine" />
        <TextView
            android:id="@+id/tvStatus"
            style="@style/Widget.WargaHubP05.Text"
            android:accessibilityLiveRegion="polite" />
        <Button
            android:id="@+id/btnSimpan"
            style="@style/Widget.WargaHubP05.Button"
            android:text="@string/simpan" />
        <Button
            android:id="@+id/btnHapus"
            style="@style/Widget.WargaHubP05.Button"
            android:text="@string/hapus" />
        <Button
            android:id="@+id/btnKembali"
            style="@style/Widget.WargaHubP05.Button"
            android:text="@string/kembali" />
    </LinearLayout>
</ScrollView>